# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@localhost:5432/ledgerline?schema=public
# DIRECT_URL is required when using connection poolers like Neon or Supabase
DIRECT_URL=postgresql://user:password@localhost:5432/ledgerline?schema=public

# Redis Configuration (Required in production, in-memory fallback permitted in development only)
REDIS_URL=redis://localhost:6379
REQUIRE_REDIS_IN_PRODUCTION=true

# Security & Secrets (Use cryptographically random keys >= 32 characters)
JWT_SECRET=replace_with_a_secure_random_minimum_32_character_jwt_secret
COOKIE_SECRET=replace_with_a_secure_random_minimum_32_character_cookie_secret
CSRF_SECRET=replace_with_a_secure_random_minimum_32_character_csrf_secret

# One-time Administrator Bootstrap Secret (Must be provided to run admin:bootstrap CLI)
ADMIN_BOOTSTRAP_SECRET=replace_with_a_secure_temporary_bootstrap_secret

