# ==============================================================================
# LedgerLine Environment Configuration Template (.env.example)
# Copy this file to .env (or backend/.env) and populate with your secure values.
# NEVER commit .env files containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
# For local development with Vite: http://localhost:5173
# For Docker Compose / Nginx reverse proxy: http://localhost
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
# PostgreSQL connection string for Prisma ORM
DATABASE_URL=postgresql://ledgerline:replace_with_a_strong_database_password@localhost:5432/ledgerline?schema=public
# DIRECT_URL is required when using connection poolers like Neon, PgBouncer, or Supabase
DIRECT_URL=postgresql://ledgerline:replace_with_a_strong_database_password@localhost:5432/ledgerline?schema=public

# Docker Compose PostgreSQL Service Environment Variables
POSTGRES_USER=ledgerline
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=ledgerline

# ------------------------------------------------------------------------------
# 3. Redis Cache & Rate Limiting Configuration
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Set to true in production to mandate Redis; false allows in-memory fallback in development
REQUIRE_REDIS_IN_PRODUCTION=true

# ------------------------------------------------------------------------------
# 4. Cryptographic Secrets (MUST be at least 32 characters in production)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_minimum_32_character_jwt_secret
COOKIE_SECRET=replace_with_a_secure_random_minimum_32_character_cookie_secret
CSRF_SECRET=replace_with_a_secure_random_minimum_32_character_csrf_secret

# ------------------------------------------------------------------------------
# 5. One-Time Administrator Bootstrap Configuration
# ------------------------------------------------------------------------------
# Token required to execute the CLI bootstrap script (minimum 16 characters)
ADMIN_BOOTSTRAP_SECRET=replace_with_a_secure_temporary_bootstrap_secret_min16chars

# Optional credentials for the one-time admin bootstrap CLI
ADMIN_BOOTSTRAP_EMAIL=admin@ledgerline.local
ADMIN_BOOTSTRAP_NAME="Primary System Administrator"
ADMIN_BOOTSTRAP_PASSWORD=replace_with_a_strong_admin_password_min8chars
